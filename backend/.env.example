DATABASE_URL=postgresql+psycopg://rfq:rfq@localhost:5434/rfq_desk

# --- Gemini ---------------------------------------------------------------
# "vertex" uses a service account (recommended); "api_key" uses AI Studio.
GEMINI_BACKEND=vertex
GEMINI_MODEL=gemini-2.5-flash
GCP_PROJECT=your-gcp-project-id
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=../secrets/gcp-sa.json
# GEMINI_API_KEY=

# --- Webhooks -------------------------------------------------------------
INBOUND_WEBHOOK_SECRET=change-me-inbound
OUTBOUND_WEBHOOK_URL=http://localhost:5678/webhook/rfq-approved
OUTBOUND_WEBHOOK_SECRET=dev-outbound-secret

# --- Gmail OAuth ----------------------------------------------------------
GMAIL_CLIENT_SECRETS_FILE=../secrets/gmail-oauth-client.json
GMAIL_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback
# Fernet key for encrypting stored OAuth tokens:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

FRONTEND_URL=http://localhost:3001
